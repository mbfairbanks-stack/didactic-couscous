# Copy this file to .env and fill in your values

# AI Insights (optional)
ANTHROPIC_API_KEY=sk-ant-...

# Admin account password (sets the password for the built-in 'admin' user)
BUDGET_PASSWORD=your-strong-password-here

# Demo account password (defaults to "demo" if not set)
DEMO_PASSWORD=demo

# Multi-user mode (default: true — leave this on)
MULTI_USER=true
