# Serves the built static app and reverse-proxies the backup API.
# handle_path strips the /api prefix, so the backend receives /backup.
49.12.212.50.sslip.io {
	handle_path /api/* {
		reverse_proxy 127.0.0.1:8787
	}
	handle {
		root * /var/www/gym-tracker

		# Vite fingerprints files in /assets, so they can cache forever.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# Everything else (index.html above all) must revalidate, so a new
		# deploy shows up immediately instead of serving a stale page.
		@notassets not path /assets/*
		header @notassets Cache-Control "no-cache"

		file_server
		try_files {path} /index.html
	}
}
